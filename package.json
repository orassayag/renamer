{
  "name": "renamer",
  "version": "1.0.0",
  "private": false,
  "description": "A powerful Node.js/TypeScript utility for bulk file renaming with pattern-based matching, comprehensive validation, and safe operation features. Built with TypeScript for type safety and reliability, this tool helps automate the process of renaming multiple files that follow specific naming patterns",
  "keywords": [
    "file",
    "files",
    "rename",
    "bulk",
    "renamer",
    "batch",
    "pattern-matching",
    "typescript",
    "file-management",
    "bulk-rename",
    "file-renaming",
    "automation"
  ],
  "homepage": "https://github.com/orassayag/renamer#readme",
  "bugs": {
    "url": "https://github.com/orassayag/renamer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/renamer.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
