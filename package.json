    "tsconfig.node.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/scripts/renameScript.ts",
    "lint": "eslint src/**/*.{ts,tsx}",
    "start": "tsx src/scripts/renameScript.ts",
    "test": "vitest"
  },
  "dependencies": {
